# Copy this file to .env and replace every change_me value before first start.
WSL_DISTRO=Ubuntu-22.04
APP_PORT=8080
DB_EXPOSE_PORT=3307

MYSQL_DATABASE=tpshop
MYSQL_USER=tpshop
MYSQL_PASSWORD=change_me_application_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Values used by the PHP application inside the Podman pod.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tpshop
DB_USER=tpshop
DB_PASSWORD=change_me_application_password
